#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Rotary Encoder Sensitivities
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <20>;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "BASE";
            bindings = <
&kp GRAVE &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                            &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp BSPC
&kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T                             &kp Y     &kp U     &kp I     &kp O     &kp P     &kp MINUS
&kp ESC   &kp A     &kp S     &kp D     &kp F     &kp G                             &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
&kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B     &kp C_MUTE    &none     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
          &kp LCMD  &kp LALT  &kp LCTRL &mo LOWER &kp RET                       &kp SPACE &mo RAISE &kp RCTRL &kp RALT  &kp RCMD
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            label = "LOWER";
            bindings = <
&trans    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5                            &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
&trans    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                            &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp F12
&trans    &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT                         &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &kp PIPE
&trans    &kp EQUAL &kp MINUS &kp PLUS  &kp LBRC  &kp RBRC  &trans        &trans    &kp LBKT  &kp RBKT  &kp SEMI  &kp COLON &kp BSLH  &trans
          &trans    &trans    &trans    &trans    &trans                            &trans    &mo ADJUST &trans   &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            label = "RAISE";
            bindings = <
&trans    &trans    &trans    &trans    &trans    &trans                            &trans    &trans    &trans    &trans    &trans    &trans
&trans    &kp INS   &kp PSCRN &kp K_CMENU &none   &none                             &kp PG_UP &kp HOME  &kp UP    &kp END   &none     &kp DEL
&trans    &kp LALT  &kp LCTRL &kp LSHFT &none     &kp CLCK                          &kp PG_DN &kp LEFT  &kp DOWN  &kp RIGHT &none     &kp BSPC
&trans    &kp K_UNDO &kp K_CUT &kp K_COPY &kp K_PASTE &none &trans       &trans    &none     &none     &none     &none     &none     &trans
          &trans    &trans    &trans    &mo ADJUST &trans                           &trans    &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            label = "ADJUST";
            bindings = <
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &none           &none           &none           &none           &none           &none
&ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &none           &none           &none           &none           &none           &none
&none             &rgb_ug RGB_BRD &rgb_ug RGB_BRI &rgb_ug RGB_SPD &rgb_ug RGB_SPI &rgb_ug RGB_EFR                         &none           &none           &none           &none           &none           &none
&none             &none           &none           &none           &none           &none           &rgb_ug RGB_TOG &none   &none           &none           &none           &none           &none           &none
                  &trans          &trans          &trans          &trans          &trans                                  &trans          &trans          &trans          &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
